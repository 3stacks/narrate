OPENROUTER_API_KEY=

# Comma-separated names shown in the import UI.
NARRATE_USERS=Margaret,Henry

# Where uploads, job state, and the working library live.
NARRATE_DATA_DIR=./data

# Jellyfin Dashboard → API Keys. Scan is skipped if blank.
JELLYFIN_API_KEY=
JELLYFIN_CONTAINER_PATH=/media/audiobooks

# Mode A: generate here, rsync over system SSH to the host that runs Jellyfin.
JELLYFIN_RSYNC_TARGET=media-server:/data/media/audiobooks
JELLYFIN_URL=http://media-server:8096
NARRATE_HOST=127.0.0.1
NARRATE_PORT=3841

# Mode B: run narrate on the same host as Jellyfin. No SSH.
# NARRATE_LIBRARY_DIR=/data/media/audiobooks
# JELLYFIN_RSYNC_TARGET=
# JELLYFIN_URL=http://127.0.0.1:8096
# NARRATE_HOST=0.0.0.0
# NARRATE_PORT=3841

# Optional HTTP basic auth for the import UI. user:password
NARRATE_BASIC_AUTH=

# openai/gpt-4o-mini-tts-2025-12-15 is the cheap high-quality default (~$0.60 / million chars).
NARRATE_DEFAULT_MODEL=openai/gpt-4o-mini-tts-2025-12-15
NARRATE_DEFAULT_VOICE=nova
